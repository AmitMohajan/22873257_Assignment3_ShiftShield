# --------------------------------------------------------
# ShiftShield Environment Variables
# --------------------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is already excluded by .gitignore.
# --------------------------------------------------------

# Supabase (used by the Python backend — set in Vercel dashboard for production)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-sb_secret-key-here

# Allow GET /api/submissions (set to "true" for local development only)
# Leave unset or "false" in production to disable the list endpoint
ALLOW_SUBMISSIONS_LIST=true

# Frontend API base URL (optional — used for local development only)
# Leave blank in production; the frontend defaults to /api automatically
VITE_API_URL=
