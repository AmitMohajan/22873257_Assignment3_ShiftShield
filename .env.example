# --------------------------------------------------------
# ShiftShield Environment Variables
# --------------------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is already excluded by .gitignore.
# --------------------------------------------------------

# Supabase (used by the Python backend — set in Vercel dashboard for production)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Frontend API base URL (optional — used for local development only)
# Leave blank in production; the frontend defaults to /api automatically
VITE_API_URL=
